# PostHog configuration
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://your-posthog-host

# Anthropic (used by /api/review, the landing page review)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Supabase (backs the rate limiter in lib/rate-limit.ts — see supabase/rate-limit.sql)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Optional: total landing page reviews allowed per day across the site (default 60)
ROAST_DAILY_LIMIT=60

# Resend (sends contact form messages to you; see app/api/contact/route.ts)
RESEND_API_KEY=your_resend_api_key
# Where messages go. Optional: defaults to the email in config.ts. Sending needs
# that address's domain verified in Resend.
CONTACT_TO_EMAIL=you@example.com

# Optional: Microlink key for more than ~25 page screenshots a day (lib/screenshot.ts)
MICROLINK_API_KEY=

# Studio admin (/admin). Set all three with: npm run admin:setup
# The secret key is only ever used on the server; never the publishable key.
SUPABASE_SECRET_KEY=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
# Local testing only: keep admin data in .admin-dev-data.json instead of Supabase.
# ADMIN_DEV_STORE=1
